# Copy to web/.env for local development. Only VITE_* variables reach the browser.
VITE_API_URL=http://localhost:8000

# Local Supabase (npx supabase start). Only the browser-safe Publishable key belongs here, never the secret/service key.
VITE_SUPABASE_URL=http://127.0.0.1:55321
# copy 'Publishable key' from `npx supabase status`
VITE_SUPABASE_PUBLISHABLE_KEY=
